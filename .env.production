# ===== 生产环境变量配置 =====
# 复制此文件为 .env（不要提交 .env 到 Git！）
# cp .env.production .env
# 然后修改 .env 中的值为真实的生产环境配置

# ===== MySQL 数据库 =====
MYSQL_PASSWORD=your-strong-mysql-password
MYSQL_DATABASE=qian_ai_agent

# ===== Neo4j 图数据库 =====
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-neo4j-password

# ===== Redis 缓存 =====
REDIS_PASSWORD=

# ===== PGVector 向量数据库 =====
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=your-strong-pg-password
PGVECTOR_DATABASE=qian_ai_agent

# ===== AI 模型 API Keys =====
SPRING_AI_OPENAI_API_KEY=your-deepseek-api-key
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_DASHSCOPE_API_KEY=your-dashscope-api-key

# ===== JWT 签名密钥（至少 256 位，生成方法见下方）=====
# 生成随机密钥: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-256-bits-long-change-me

# ===== Tavily 联网搜索 =====
SEARCH_API_API_KEY=your-tavily-api-key
