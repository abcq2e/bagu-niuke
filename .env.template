# ===== Yu AI Agent 环境变量配置模板 =====
# 复制此文件为 .env（不要提交 .env 到 Git！）
# cp .env.template .env
# 然后修改 .env 中的值

# ===== AI 模型 API Key =====
# DeepSeek API Key（通过 OpenAI 兼容协议接入）
SPRING_AI_OPENAI_API_KEY=your-deepseek-api-key-here
# DeepSeek API 地址（默认 https://api.deepseek.com）
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com

# 阿里云 DashScope API Key（通义千问模型）
SPRING_AI_DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ===== 数据库配置 =====
# MySQL 数据库密码
SPRING_DATASOURCE_PASSWORD=your-mysql-password
# Neo4j 数据库密码
SPRING_NEO4J_AUTHENTICATION_PASSWORD=your-neo4j-password

# ===== JWT 令牌签名密钥（至少 256 位） =====
JWT_SECRET=your-jwt-secret-at-least-256-bits-long

# ===== Tavily 联网搜索 API Key =====
# 注册地址: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ===== 其他（可选） =====
# 服务器端口（默认 8123）
# SERVER_PORT=8123
